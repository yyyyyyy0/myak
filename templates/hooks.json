{
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__MYAK_HOOK__ stop",
          "async": true,
          "timeout": 60,
          "statusMessage": "myak: indexing"
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__MYAK_HOOK__ session-end",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "__MYAK_HOOK__ prompt",
          "timeout": 10
        }
      ]
    }
  ]
}
